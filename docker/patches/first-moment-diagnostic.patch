+void LumpedPortData::GetVoltageFunctional(mfem::ParFiniteElementSpace &nd_fespace,
+                                          mfem::Vector &f) const
+{
+  // The true-dof functional is the Pᵀ (dual) assembly of the local linear form v: the
+  // rank-local dot products v ⋅ (P E_true) summed over ranks in GetVoltage equal
+  // (Pᵀ v) ⋅ E_true, which is what mfem::ParLinearForm::ParallelAssemble computes.
+  InitializeLinearForms(nd_fespace);
+  f.SetSize(nd_fespace.GetTrueVSize());
+  nd_fespace.GetProlongationMatrix()->MultTranspose(*v, f);
+}
