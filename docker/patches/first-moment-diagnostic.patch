+double GlobalMaxRSSMB(MPI_Comm comm)
+{
+  struct rusage ru;
+  getrusage(RUSAGE_SELF, &ru);
+  double mb = static_cast<double>(ru.ru_maxrss) / 1024.0;  // Linux reports ru_maxrss in kB
+  Mpi::GlobalMax(1, &mb, comm);
+  return mb;
+}
+
+// Read a one-line identity file written into the image by its Dockerfile. Returns an empty
+// string when the file is absent, which the record reports as "unavailable" so that
+// evaluation fails closed rather than silently accepting an unidentified binary.
+std::string ReadImageInfoFile(const std::string &dir, const std::string &name)
+{
+  std::ifstream fi(dir + "/" + name);
+  if (!fi.is_open())
+  {
+    return {};
+  }
+  std::string line;
+  std::getline(fi, line);
+  while (!line.empty() && (line.back() == '\n' || line.back() == '\r' || line.back() == ' '))
+  {
+    line.pop_back();
+  }
+  return line;
+}
+
+}  // namespace
+
+std::pair<ErrorIndicator, long long int>
+FirstMomentSolver::Solve(const std::vector<std::unique_ptr<Mesh>> &mesh) const
+{
+  // The first spectral moment of the lumped-port voltage functional,
+  //     A = Σ_m λ_m p_m = Re(fᴴ M⁻¹ f) / L ,
+  // evaluated on the PEC-constrained (free) true dofs. M is SpaceOperator::GetMassMatrix
+  // with DIAG_ONE, which acts as [[M_free, 0], [0, I]] on the true dofs (ParOperator::Mult
+  // zeros x on the essential dofs before prolongation and sets y = x there afterwards), so
+  // with f zeroed on the essential dofs the padded solve is exactly M_free x = f_free with
+  // x = 0 on the essential dofs and fᵀx = f_freeᵀ M_free⁻¹ f_free: no artificial boundary
+  // contribution. The functional f = Pᵀ v is the exact GetVoltage linear form.
+  const auto t_start = Timer::Now();
+  BlockTimer bt0(Timer::CONSTRUCT);
+  SpaceOperator space_op(iodata, mesh);
+  auto &nd_fespace = space_op.GetNDSpace();
+  MPI_Comm comm = space_op.GetComm();
+  const auto &dbc_tdof_list = space_op.GetNDDbcTDofLists().back();
+  const auto &opts = iodata.solver.firstmoment;
+  SaveMetadata(space_op.GetNDSpaces());
+
+  // Provenance: what binary, built from what source and what patch, is producing this
+  // record. The identity files are written into the image by its Dockerfile; the directory
+  // is overridable only so that a non-image (developer) build can be run and, because the
+  // record states the directory it read, such a run is distinguishable from an image run.
+  const char *info_env = std::getenv("PALACE_IMAGE_INFO_DIR");
+  const std::string info_dir = info_env ? std::string(info_env) : std::string("/opt/palace");
+  json prov;
+  prov["ImageInfoDir"] = info_dir;
+  prov["ImageInfoDirIsDefault"] = (info_dir == "/opt/palace");
+  for (const char *name :
+       {"PALACE_VERSION", "PALACE_COMMIT", "PALACE_PATCH", "PALACE_PATCH_SHA256"})
+  {
+    const auto value = ReadImageInfoFile(info_dir, name);
+    prov[name] = value.empty() ? std::string("unavailable") : value;
+  }
+  prov["ConfigMesh"] = iodata.model.mesh;
+  prov["MpiSize"] = Mpi::Size(comm);
+  Mpi::Print("\nFirst-moment diagnostic provenance:\n source = {}, commit = {}, patch = {} "
+             "({})\n",
+             info_dir, prov["PALACE_COMMIT"].get<std::string>(),
+             prov["PALACE_PATCH"].get<std::string>(),
+             prov["PALACE_PATCH_SHA256"].get<std::string>());
+
+  // Structured failure evidence: a failed check writes first-moment-FAILED.json and aborts.
+  // It never writes first-moment.json, so a failed run cannot be mistaken for a result.
+  auto WriteFailure = [&](const std::string &reason, const json &details)
+  {
+    if (root && post_dir.length() > 0)
+    {
+      json out;
+      out["Diagnostic"] = "FirstMoment";
+      out["Status"] = "FAILED";
+      out["Reason"] = reason;
+      out["Details"] = details;
+      out["Provenance"] = prov;
+      std::ofstream fo(post_dir + "first-moment-FAILED.json");
+      if (fo.is_open())
+      {
+        fo << out.dump(2) << '\n';
+      }
+    }
+    Mpi::Barrier(comm);
+  };
+
+  // Exactly one active lumped port with nonzero inductance defines the functional.
+  const LumpedPortData *port = nullptr;
+  int port_idx = -1;
+  for (const auto &[idx, data] : space_op.GetLumpedPortOp())
+  {
+    if (data.active && std::abs(data.L) > 0.0)
+    {
+      if (port)
+      {
+        WriteFailure("multiple active lumped ports with nonzero inductance",
+                     {{"first", port_idx}, {"second", idx}});
+        MFEM_ABORT("The first-moment diagnostic requires exactly one active lumped port "
+                   "with nonzero inductance!");
+      }
+      port = &data;
+      port_idx = idx;
+    }
+  }
+  if (!port)
+  {
+    WriteFailure("no active lumped port with nonzero inductance",
+                 {{"num_ports", space_op.GetLumpedPortOp().Size()}});
+    MFEM_ABORT("The first-moment diagnostic requires an active lumped port with nonzero "
+               "inductance!");
+  }
+  const double L_nd = port->L;
+
+  // Dof counts: total true dofs, essential (PEC) true dofs and free true dofs.
+  const HYPRE_BigInt n_true = nd_fespace.GlobalTrueVSize();
+  HYPRE_BigInt n_dbc = dbc_tdof_list.Size();
+  Mpi::GlobalSum(1, &n_dbc, comm);
+  const HYPRE_BigInt n_free = n_true - n_dbc;
+  Mpi::Print("\nFirst-moment diagnostic on lumped port {:d}: {:d} true dofs, {:d} essential, "
+             "{:d} free\n",
+             port_idx, n_true, n_dbc, n_free);
+
+  // The voltage functional on the true dofs, f = Pᵀ v, restricted to the free dofs.
+  Vector f(nd_fespace.GetTrueVSize());
+  f.UseDevice(true);
+  port->GetVoltageFunctional(nd_fespace.Get(), f);
+  const double f_norm2_full = linalg::Dot(comm, f, f);
+  linalg::SetSubVector(f, dbc_tdof_list, 0.0);
+  const double f_norm2_free = linalg::Dot(comm, f, f);
+  if (!(f_norm2_free > 0.0))
+  {
+    WriteFailure("the lumped port voltage functional vanishes on the free dofs",
+                 {{"norm2_full", f_norm2_full}, {"norm2_free", f_norm2_free}});
+    MFEM_ABORT("The lumped port voltage functional vanishes on the free dofs!");
+  }
+
+  // Check 1: the extracted true-dof functional reproduces GetVoltage on a random complex
+  // field that satisfies the PEC constraint (both parts vanish on the essential dofs).
+  constexpr double check_functional_tol = 1.0e-10;
+  json check_f;
+  check_f["Enabled"] = opts.check_functional;
+  if (opts.check_functional)
+  {
+    ComplexVector Et(nd_fespace.GetTrueVSize());
+    Et.UseDevice(true);
+    linalg::SetRandom(comm, Et, opts.seed);
+    linalg::SetSubVector(Et, dbc_tdof_list, 0.0);
+    GridFunction E(nd_fespace, true);
+    E.Real().SetFromTrueDofs(Et.Real());
+    E.Imag().SetFromTrueDofs(Et.Imag());
+    const std::complex<double> V_ref = port->GetVoltage(E);
+    const std::complex<double> V_f(linalg::Dot(comm, f, Et.Real()),
+                                   linalg::Dot(comm, f, Et.Imag()));
+    const double denom = std::max(std::abs(V_ref), std::numeric_limits<double>::min());
+    const double rel = std::abs(V_f - V_ref) / denom;
+    check_f["Seed"] = opts.seed;
+    check_f["V_GetVoltage"] = {V_ref.real(), V_ref.imag()};
+    check_f["V_Functional"] = {V_f.real(), V_f.imag()};
+    check_f["RelativeError"] = rel;
+    check_f["Tolerance"] = check_functional_tol;
+    check_f["Passed"] = (rel < check_functional_tol);
+    Mpi::Print(" Functional check: |V_f - V_GetVoltage| / |V_GetVoltage| = {:.3e}\n", rel);
+    if (!(rel < check_functional_tol))
+    {
+      WriteFailure("the true-dof voltage functional does not reproduce GetVoltage",
+                   check_f);
+      MFEM_ABORT("The true-dof voltage functional does not reproduce GetVoltage!");
+    }
+  }
+
+  // The SPD mass solve: Jacobi-preconditioned CG on M(DIAG_ONE) = [[M_free, 0], [0, I]].
+  auto M = space_op.GetMassMatrix<Operator>(Operator::DIAG_ONE);
+  if (!M)
+  {
+    WriteFailure("the mass matrix is empty", {});
+    MFEM_ABORT("The first-moment diagnostic requires a nonzero mass matrix!");
+  }
+  auto pcg = std::make_unique<CgSolver<Operator>>(comm, iodata.problem.verbose);
+  pcg->SetInitialGuess(false);
+  pcg->SetRelTol(opts.tol);
+  pcg->SetAbsTol(std::numeric_limits<double>::epsilon());
+  pcg->SetMaxIter(opts.max_it);
+  const CgSolver<Operator> *cg = pcg.get();
+  auto pc = std::make_unique<JacobiSmoother<Operator>>(comm);
+  KspSolver ksp(std::move(pcg), std::move(pc));
+  ksp.SetOperators(*M, *M);
+
+  Vector x(f.Size()), r(f.Size());
+  x.UseDevice(true);
+  r.UseDevice(true);
+  x = 0.0;
+  Mpi::Print("\nSolving M x = f (mass matrix, free dofs) with PCG + Jacobi\n");
+  ksp.Mult(f, x);
+
+  // Independent residual r = M x - f, and the part of x on the essential dofs (must be 0).
+  M->Mult(x, r);
+  r.Add(-1.0, f);
+  const double r_norm = linalg::Norml2(comm, r);
+  const double f_norm = std::sqrt(f_norm2_free);
+  const double x_norm = linalg::Norml2(comm, x);
+  const double xr = linalg::Dot(comm, x, r);
+  const double fx = linalg::Dot(comm, f, x);
+  Vector xd(x.Size());
+  xd.UseDevice(true);
+  xd = 0.0;
+  linalg::SetSubVector(xd, dbc_tdof_list, x);
+  const double x_dbc_norm = linalg::Norml2(comm, xd);
+
+  // The moment, in nondimensional units and in GHz². With λ = ω² in units of 1/tc²,
+  // f_GHz = ω_nd / (2π tc) (IoData::ValueType::FREQUENCY), so A_GHz² = A_nd / (2π tc)².
+  //
+  // ERROR QUALIFICATION. With x* = M⁻¹f exact and r = M x - f, substituting f = M x - r
+  // into both quadratic forms gives the EXACT identity
+  //     fᵀx - fᵀM⁻¹f = (xᵀMx - rᵀx) - (xᵀMx - 2xᵀr + rᵀM⁻¹r) = xᵀr - rᵀM⁻¹r ,
+  // i.e.  A_computed - A_exact = (Re(xᴴr) - rᴴM⁻¹r) / L .
+  // M is SPD, so rᴴM⁻¹r ≥ 0 and therefore
+  //     A_computed - A_exact ≤ Re(xᴴr)/L    (a CERTIFIED one-sided bound, no conditioning
+  //                                          information required),
+  // equivalently A_exact ≥ A_computed - Re(xᴴr)/L. The same number is the variational
+  // lower bound 2fᵀx - xᵀMx over L. A certified UPPER bound on A_exact needs rᴴM⁻¹r, hence
+  // a lower bound on λ_min(M_free) or a second solve; neither is computed here, so none is
+  // reported. ‖x‖‖r‖/L is an ESTIMATE of the error, not a bound: the rᴴM⁻¹r term can
+  // exceed it when M is ill conditioned.
+  const double freq_scale = iodata.DimensionalizeValue(IoData::ValueType::FREQUENCY, 1.0);
+  const double ghz2_per_nd = freq_scale * freq_scale;
+  const double A_nd = fx / L_nd;
+  const double A_GHz2 = A_nd * ghz2_per_nd;
+  const double err_ub_nd = xr / L_nd;
+  const double A_lower_nd = A_nd - err_ub_nd;
+  const double est_nd = x_norm * r_norm / L_nd;
+  Mpi::Print(" A_nd = {:.12e}, A_GHz2 = {:.12e}\n ‖r‖/‖f‖ = {:.3e}, iterations = {:d}, "
+             "converged = {}\n certified lower bound on A_nd = {:.12e}\n",
+             A_nd, A_GHz2, r_norm / f_norm, cg->GetNumIterations(), cg->GetConverged(),
+             A_lower_nd);
+
+  // Check 2: the inequality uᵀ K u ≥ (fᵀu)² / L = (qᵀu)² on the actual constrained
+  // assembly, for the solution x and random constrained fields. It is a RUNTIME SANITY
+  // CHECK on sampled vectors, not a proof for every vector: the proof that K ≥ q qᴴ is the
+  // quadrature-parity argument made against the source, kept separate from this sampling.
+  json check_k;
+  check_k["Enabled"] = opts.check_null_space;
+  check_k["IsSampledNotProof"] = true;
+  if (opts.check_null_space)
+  {
+    auto K = space_op.GetStiffnessMatrix<Operator>(Operator::DIAG_ONE);
+    if (!K)
+    {
+      WriteFailure("the stiffness matrix is empty", {});
+      MFEM_ABORT("The first-moment diagnostic requires a nonzero stiffness matrix!");
+    }
+    Vector u(f.Size()), Ku(f.Size());
+    u.UseDevice(true);
+    Ku.UseDevice(true);
+    double min_gap = std::numeric_limits<double>::infinity();
+    json samples = json::array();
+    for (int k = 0; k <= opts.num_null_space_samples; k++)
+    {
+      if (k == 0)
+      {
+        u = x;
+      }
+      else
+      {
+        linalg::SetRandom(comm, u, opts.seed + k);
+      }
+      linalg::SetSubVector(u, dbc_tdof_list, 0.0);
+      K->Mult(u, Ku);
+      const double uKu = linalg::Dot(comm, u, Ku);
+      const double fu = linalg::Dot(comm, f, u);
+      const double qu2 = fu * fu / L_nd;
+      const double gap = (uKu - qu2) / std::max(uKu, std::numeric_limits<double>::min());
+      min_gap = std::min(min_gap, gap);
+      samples.push_back({{"Sample", (k == 0) ? "solution" : "random"},
+                         {"uKu", uKu},
+                         {"qu2", qu2},
+                         {"RelativeGap", gap}});
+    }
+    check_k["Samples"] = samples;
+    check_k["NumSamples"] = static_cast<int>(samples.size());
+    check_k["MinRelativeGap"] = min_gap;
+    check_k["Tolerance"] = -1.0e-10;
+    check_k["Passed"] = (min_gap >= -1.0e-10);
+    Mpi::Print(" Null-space check (sampled): min (uᵀKu - (qᵀu)²) / uᵀKu = {:.3e}\n",
+               min_gap);
+    if (!(min_gap >= -1.0e-10))
+    {
+      WriteFailure("K >= q q^H violated on the constrained assembly", check_k);
+      MFEM_ABORT("K ≥ q qᴴ violated on the constrained assembly!");
+    }
+  }
+
+  // Outputs.
+  BlockTimer bt1(Timer::POSTPRO);
+  SaveMetadata(ksp);
+  const double wall_s = Timer::Duration(Timer::Now() - t_start).count();
+  const double rss_mb = GlobalMaxRSSMB(comm);
+  if (root && post_dir.length() > 0)
+  {
+    json out;
+    out["Diagnostic"] = "FirstMoment";
+    out["Status"] = "COMPLETED";
+    out["Provenance"] = prov;
+    out["Port"] = {{"Index", port_idx},
+                   {"L_nd", L_nd},
+                   {"L_H", iodata.DimensionalizeValue(IoData::ValueType::INDUCTANCE, L_nd)},
+                   {"NumElements", static_cast<int>(port->elems.size())}};
+    out["Dofs"] = {{"True", n_true}, {"Essential", n_dbc}, {"Free", n_free}};
+    out["Scales"] = {
+        {"Lc_m", iodata.DimensionalizeValue(IoData::ValueType::LENGTH, 1.0)},
+        {"tc_ns", iodata.DimensionalizeValue(IoData::ValueType::TIME, 1.0)},
+        {"FrequencyScale_GHz", freq_scale},
+        {"InductanceScale_H", iodata.DimensionalizeValue(IoData::ValueType::INDUCTANCE, 1.0)},
+        {"A_GHz2_per_nd", ghz2_per_nd}};
+    out["Functional"] = {{"NormSquaredFull", f_norm2_full},
+                         {"NormSquaredFree", f_norm2_free},
+                         {"NormSquaredEssential", f_norm2_full - f_norm2_free},
+                         {"Check", check_f}};
+    out["LinearSolve"] = {{"Type", "PCG+Jacobi on M(DIAG_ONE)"},
+                          {"RelTol", opts.tol},
+                          {"MaxIts", opts.max_it},
+                          {"Iterations", cg->GetNumIterations()},
+                          {"Converged", cg->GetConverged()},
+                          {"SolverFinalRes", cg->GetFinalRes()},
+                          {"ResidualNorm", r_norm},
+                          {"RhsNorm", f_norm},
+                          {"RelativeResidual", r_norm / f_norm},
+                          {"SolutionNorm", x_norm},
+                          {"SolutionEssentialNorm", x_dbc_norm}};
+    out["A"] = {
+        {"A_nd", A_nd},
+        {"A_GHz2", A_GHz2},
+        {"ErrorIdentity",
+         "A_computed - A_exact = (Re(x^H r) - r^H M^-1 r) / L, with r = M x - f"},
+        {"XDotR_nd", xr},
+        {"CertifiedErrorUpperBound_nd", err_ub_nd},
+        {"CertifiedErrorUpperBound_GHz2", err_ub_nd * ghz2_per_nd},
+        {"CertifiedLowerBound_A_nd", A_lower_nd},
+        {"CertifiedLowerBound_A_GHz2", A_lower_nd * ghz2_per_nd},
+        {"CertifiedLowerBoundJustification",
+         "r^H M^-1 r >= 0 because M is SPD, so A_computed - A_exact <= Re(x^H r)/L; the "
+         "same number is the variational lower bound (2 f^T x - x^T M x)/L"},
+        {"UncertifiedErrorEstimate_nd", est_nd},
+        {"UncertifiedErrorEstimate_GHz2", est_nd * ghz2_per_nd},
+        {"UncertifiedErrorEstimateNote",
+         "||x|| ||r|| / L is an ESTIMATE, not a bound: the r^H M^-1 r term of the identity "
+         "can exceed it when M is ill conditioned"},
+        {"CertifiedUpperBound", "UNAVAILABLE"},
+        {"CertifiedUpperBoundRequires",
+         "a lower bound on lambda_min(M_free), or a second solve for r^H M^-1 r; neither "
+         "is computed by this diagnostic"}};
+    out["NullSpaceCheck"] = check_k;
+    out["Resources"] = {{"WallTime_s", wall_s}, {"MaxRSS_MB", rss_mb}};
+    const std::string path = post_dir + "first-moment.json";
+    std::ofstream fo(path);
+    MFEM_VERIFY(fo.is_open(), "Unable to open first-moment output file \"" << path << "\"!");
+    fo << out.dump(2) << '\n';
+  }
+  Mpi::Print(" Wall time = {:.2f} s, max RSS = {:.1f} MB\n", wall_s, rss_mb);
+  return {ErrorIndicator(), space_op.GlobalTrueVSize()};
+}
+
+}  // namespace palace
