+#ifndef PALACE_DRIVERS_FIRST_MOMENT_SOLVER_HPP
+#define PALACE_DRIVERS_FIRST_MOMENT_SOLVER_HPP
+
+#include <memory>
+#include <vector>
+#include "drivers/basesolver.hpp"
+
+namespace palace
+{
+
+class ErrorIndicator;
+class Mesh;
+
+//
+// Diagnostic driver: the first spectral moment of the lumped-port voltage functional,
+//     A = Σ_m λ_m p_m = Re(f_freeᴴ M_free⁻¹ f_free) / L ,
+// on the PEC-constrained (free) true dofs of the same Nédélec space, material model and
+// mass matrix as the eigenmode driver. One SPD linear solve; no eigenproblem, no driven
+// sweep, no fields written. Writes postpro/first-moment.json.
+//
+class FirstMomentSolver : public BaseSolver
+{
+private:
+  std::pair<ErrorIndicator, long long int>
+  Solve(const std::vector<std::unique_ptr<Mesh>> &mesh) const override;
+
+public:
+  using BaseSolver::BaseSolver;
+};
+
+}  // namespace palace
+
+#endif  // PALACE_DRIVERS_FIRST_MOMENT_SOLVER_HPP
