#!/bin/sh
# Pre-push secret scan (CLAUDE.md section 10, AGENTS.md section 11).
#
# "Run the repository's approved secret scanner before evidence-bearing pushes."
# Until this existed that was a habit. CI scanned the tip tree AFTER the push, so a
# secret was already on GitHub by the time it was flagged; the approved scanner could
# detect it and simply was not asked. This asks it, before the objects leave.
#
# FAIL CLOSED, AND AFFIRMATIVELY. A push proceeds only on an exit status of 0 together
# with the scanner's own clean marker on its output. Everything else refuses: no
# interpreter, no scanner, findings, BLOCKED, a crash, an unrecognised exit code, or a
# zero exit with no marker. "Could not scan" is never "nothing to find".
#
# Requiring the marker is not belt-and-braces. An uncaught Python exception also exits
# 1, so the exit code ALONE cannot tell a findings verdict from a crash - an earlier
# draft of this hook reported a crash as "found secret(s)", refusing correctly but
# saying something untrue about why.
#
# It does NOT replace the CI job, which stays as defence in depth. See
# docs/agent-contract-implementation.md for what this does not protect against.
set -eu

ZERO="0000000000000000000000000000000000000000"
ROOT=$(git rev-parse --show-toplevel)
SCANNER="$ROOT/scripts/secret_scan.py"
CLEAN_MARKER="secret scan clean"
FINDING_MARKER="SECRET SCAN FOUND"
BLOCKED_MARKER="SECRET SCAN BLOCKED"

refuse() {
    printf '\n*** PUSH REFUSED: %s\n' "$1" >&2
    printf '    The repository requires an affirmative clean scan by its approved\n' >&2
    printf '    scanner before a push. Remove the secret and rewrite the change; do\n' >&2
    printf '    not add a baseline and do not bypass the hook.\n' >&2
    exit 1
}

if [ -x "$ROOT/.venv/bin/python" ]; then
    PY="$ROOT/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    refuse "no Python interpreter found, so the approved scanner cannot run (BLOCKED)"
fi
[ -f "$SCANNER" ] || refuse "the approved scanner is missing at scripts/secret_scan.py (BLOCKED)"

OUT=$(mktemp) || refuse "cannot create a temporary file for the scan output (BLOCKED)"
trap 'rm -f "$OUT"' EXIT INT TERM

scan() {
    # $1 = human label; everything after it is the scanner's own scope arguments.
    # The label MUST be shifted off: passing it through made argparse exit 2, which the
    # indeterminate branch then reported as a broken scanner, refusing every push
    # including clean ones. Fail-closed hid that bug rather than causing it, which is
    # why the positive control matters as much as the negative one.
    label="$1"
    shift
    set +e
    "$PY" "$SCANNER" "$@" >"$OUT" 2>&1
    code=$?
    set -e
    if [ "$code" -eq 0 ]; then
        grep -q "$CLEAN_MARKER" "$OUT" \
            || refuse "the approved scanner exited 0 for ${label} without its clean marker;
    an unrecognised success is not an affirmative clean scan"
        return 0
    fi
    if [ "$code" -eq 1 ] && grep -q "$FINDING_MARKER" "$OUT"; then
        refuse "the approved scanner found secret(s) in ${label}"
    fi
    if [ "$code" -eq 3 ] || grep -q "$BLOCKED_MARKER" "$OUT"; then
        refuse "the approved scanner reported BLOCKED for ${label} (unavailable or unverifiable)"
    fi
    refuse "the approved scanner exited ${code} for ${label} with no recognised verdict;
    an indeterminate scan is not a clean one"
}

refs=0
scanned=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    refs=$((refs + 1))
    if [ "$local_sha" = "$ZERO" ]; then
        continue                       # a branch deletion pushes no content
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        # A ref the remote does not have yet: the pushed range is not well defined, so
        # scan the whole tracked tree at the tip. A superset, deliberately.
        scan "the tracked tree at ${local_sha}" --tree
    else
        git cat-file -e "${remote_sha}^{commit}" 2>/dev/null \
            || refuse "cannot resolve the remote commit ${remote_sha}, so the pushed range
    is unknown (BLOCKED)"
        scan "${remote_sha}..${local_sha}" --range "${remote_sha}..${local_sha}"
    fi
    scanned=$((scanned + 1))
done

if [ "$refs" -eq 0 ]; then
    # Nothing was described on stdin. Rather than assume that means "nothing to push",
    # scan the tracked tree and let the scanner decide.
    scan "the tracked tree (no ref information on stdin)" --tree
    scanned=$((scanned + 1))
elif [ "$scanned" -eq 0 ]; then
    printf 'pre-push: %s ref(s), all deletions; no content to scan\n' "$refs" >&2
    exit 0
fi

printf 'pre-push: secret scan clean (%s scope(s), approved scanner)\n' "$scanned" >&2
exit 0
